# =============================================================================
# 本地开发环境模板
# 用法：复制为 .env.development 后填写真实值
# 读取：npm run dev / prisma migrate dev / npm run db:test:local
# =============================================================================

# --- 运行环境 ---
# 脚本里不再用 `NODE_ENV=xxx cmd` 这种 Unix 写法（Windows 的 cmd 不认），改由这里提供
NODE_ENV=development

# --- 服务端口 ---
# 后端 API 监听端口（Vite 开发服实际在 5010，见 README；后端默认 5409）
# 运行环境（脚本里不再用 `NODE_ENV=xxx cmd` 这种 Unix 写法，改由这里提供）
# --- 服务端口 ---
SERVER_PORT=5409

# --- 前端 / API 地址 ---
# 前端请求后端的 Base URL（开发时必须指向本地后端，留空会打到 Vite 端口）
VITE_API_BASE_URL=http://localhost:5409
# 首次初始化 AI 厂商时的默认上游地址（写入运行时 HTML 配置）
VITE_PROVIDER_DEFAULT_BASE_URL=https://api.chatfire.site/v1

# --- 静态资源与上传 ---
# 生产构建产物目录（本地开发一般保持 dist）
STATIC_DIST_DIR=dist
# 用户上传文件本地存储目录
UPLOADS_DIR=uploads

# --- 跨域 ---
# 允许访问后端 API 的前端来源，多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5409,http://localhost:5010,http://127.0.0.1:5010

# --- MySQL ---
# 主库连接串；MySQL 8 本地开发建议加 ?allowPublicKeyRetrieval=true
DATABASE_URL=mysql://root:password@127.0.0.1:3306/canana_mind?allowPublicKeyRetrieval=true
# Prisma migrate dev 用的 shadow 库（可与主库同实例不同库名）
SHADOW_DATABASE_URL=mysql://root:password@127.0.0.1:3306/canana_mind_shadow?allowPublicKeyRetrieval=true

# --- 加密密钥 ---
# 用户自定义厂商 API Key 加密密钥（生产环境务必更换）
PROVIDER_CONFIG_SECRET=please-change-this-secret
# 对象存储配置加密密钥
STORAGE_CONFIG_SECRET=please-change-this-storage-secret
# 服务端默认上游厂商地址（后台未配置时的兜底）
PROVIDER_DEFAULT_BASE_URL=https://api.chatfire.site/v1

# --- 登录与会话 ---
# 短信/邮箱验证码有效期（分钟）
AUTH_LOGIN_CODE_EXPIRE_MINUTES=5
# 登录 Cookie 会话有效期（天）
AUTH_SESSION_EXPIRE_DAYS=30
# 是否在发码响应里回显验证码明文（debugCode）。
# 本地开发没有真实短信/邮件通道，需要回显才能自动填充登录；开启会打印 warning 日志。
# 默认关闭；NODE_ENV=production 时无论此项如何都强制关闭（生产严禁开启，否则任意账号可被接管）。
AUTH_DEBUG_CODE_ENABLED=false
# 本地脚本（pi-smoke / verify-local-db-wiring / verify-pipeline-lock-db）登录用的管理员密码。
# 缺失时脚本会直接报错退出，不回落默认值。请填本地开发环境自己的密码，不要把真实密码提交到仓库。
DEV_ADMIN_PASSWORD=

# --- Redis（任务状态、缓存、限流；本地建议开启）---
# 是否启用 Redis；false 时任务状态仅内存，单实例可用
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 逻辑库编号（0-15）
REDIS_DATABASE=1
# 完整 Redis URL；填写后优先于 HOST/PORT/PASSWORD/DATABASE
REDIS_URL=
# 缓存 Key 前缀，多环境共用同一 Redis 时用于隔离
REDIS_PREFIX=canana
# 环境标识，会拼进 Redis Key（development / production）
REDIS_ENV=development

# --- 可选高级配置（一般不用改，省略则走代码默认值）---
# REDIS_DEFAULT_TTL_SECONDS=60
# REDIS_TASK_RUNTIME_TTL_SECONDS=1800
# REDIS_TASK_SNAPSHOT_TTL_SECONDS=1800
# REDIS_TASK_ABORT_TTL_SECONDS=300
# REDIS_TASK_LOCK_TTL_MS=30000
# LOG_LEVEL=debug
# SWAGGER_ENABLED=true
